{
  "statusLine": {
    "type": "command",
    "command": "bash /Users/gabriel/.claude/statusline.sh",
    "padding": 0
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/kza_safety_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/kza_precompact.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}

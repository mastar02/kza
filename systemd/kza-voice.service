# USER unit — se instala en ~kza/.config/systemd/user/kza-voice.service y se
# gestiona con `systemctl --user` desde la sesión de kza. NO es una unit de
# sistema: kza-voice corre rootless como el usuario kza (sin sudo, sin root),
# ver docs/architecture/ROOTLESS_MIGRATION.md. Sobrevive logout/reboot vía
# `loginctl enable-linger kza`.
#
# En el server puede existir un drop-in kza-voice.service.d/llm-auth.conf con
# EnvironmentFile=- adicionales para las API keys de los LLM locales.

[Unit]
Description=KZA Voice Pipeline — asistente domótico (STT+NLU+TTS+HA)
Documentation=file:///home/kza/app/CLAUDE.md
# Excepción R10 #3 (Notion pág 8): USB ReSpeaker + MA1260 serial + <300ms latency
After=network-online.target kza-llm-ik.service
Wants=network-online.target kza-llm-ik.service
# Requires removed: 72B is optional (fast path works without it)
StartLimitBurst=3
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=/home/kza/app
EnvironmentFile=/home/kza/secrets/.env
EnvironmentFile=-/home/kza/secrets/vllm-api-key.env
EnvironmentFile=-/home/kza/secrets/llama-api-key.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/kza/app/.venv/bin/python -m src.main

Restart=on-failure
RestartSec=10s
TimeoutStartSec=120s

[Install]
WantedBy=default.target

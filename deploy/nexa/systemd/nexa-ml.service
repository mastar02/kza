[Unit]
Description=Nexa Stateless GPU ML Worker (Whisper, Kokoro streaming TTS, ECAPA, BGE-M3)
PartOf=nexa.target

[Service]
Type=notify
WorkingDirectory=/opt/nexa/current/ml
ExecStart=/opt/nexa/ml-venv/bin/python -m nexa_ml --socket %t/nexa/ml.sock --config /etc/nexa/nexa.toml
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/var/lib/nexa XDG_CACHE_HOME=/tmp
RuntimeDirectory=nexa
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
LockPersonality=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
MemoryMax=16G
CPUQuota=800%
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=180s
TimeoutStartSec=120s
TimeoutStopSec=10s
WatchdogSec=30s

[Install]
WantedBy=nexa.target

[Unit]
Description=Nexa Fast Local LLM Router (Qwen2.5-7B-Instruct Q4_K_M on cuda:1, RTX 3070 8 GiB, :8101)
PartOf=nexa.target

[Service]
Type=simple
EnvironmentFile=-/etc/nexa/secrets/llm-fast.env
Environment=CUDA_VISIBLE_DEVICES=1 LD_LIBRARY_PATH=/opt/nexa/lib
RuntimeDirectory=nexa-llm-fast
RuntimeDirectoryMode=0700
ExecStart=/opt/nexa/bin/llama-server \
  --model /opt/nexa/models/Qwen2.5-7B-Instruct-Q4_K_M/Qwen2.5-7B-Instruct-Q4_K_M.gguf \
  --host 127.0.0.1 --port 8101 -t 16 -tb 16 -c 2048 -ctk q8_0 -ctv q8_0 -ngl 20 \
  --api-key-file /etc/nexa/secrets/llama-api-key
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
LockPersonality=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
IPAddressAllow=127.0.0.1/32
MemoryMax=16G
CPUQuota=1600%
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=180s
TimeoutStopSec=10s

[Install]
WantedBy=nexa.target

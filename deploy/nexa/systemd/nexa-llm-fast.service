[Unit]
Description=Nexa Fast Local LLM Router (Qwen3.5-9B Q4_K_M on dedicated cuda:1, RTX 3070 8 GiB, :8101)
PartOf=nexa.target
StartLimitBurst=5
StartLimitIntervalSec=180s

[Service]
Type=simple
EnvironmentFile=-/etc/nexa/secrets/llm-fast.env
Environment=CUDA_VISIBLE_DEVICES=1 LD_LIBRARY_PATH=/opt/nexa/lib
RuntimeDirectory=nexa-llm-fast
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/opt/nexa/bin/llama-server \
  --model /opt/nexa/models/Qwen3.5-9B-Q4_K_M/Qwen3.5-9B-Q4_K_M.gguf \
  --host 127.0.0.1 --port 8101 -t 8 -tb 8 -c 4096 -ctk q8_0 -ctv q8_0 -ngl 99 \
  --jinja --parallel 1 --minilog \
  --api-key-file /etc/nexa/secrets/llama-api-key
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes
MemoryMax=16G
CPUQuota=1600%
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=nexa.target

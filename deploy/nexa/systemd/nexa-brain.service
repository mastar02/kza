[Unit]
Description=Nexa Voice Brain (NLU, Orchestrator, HA WS Cache, Household Core, LLM Failover)
PartOf=nexa.target
After=network-online.target nexa-audiod.service nexa-ml.service nexa-memoryd.service nexa-llm-fast.service
Wants=network-online.target nexa-audiod.service nexa-ml.service nexa-memoryd.service nexa-llm-fast.service
StartLimitBurst=5
StartLimitIntervalSec=120s

[Service]
Type=notify
ExecStart=/opt/nexa/current/bin/nexa-brain --config-dir /etc/nexa
EnvironmentFile=/etc/nexa/secrets/brain.env
RuntimeDirectory=nexa
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nexa/household
LockPersonality=yes
RestrictSUIDSGID=yes
MemoryMax=4G
CPUQuota=400%
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
WatchdogSec=30s

[Install]
WantedBy=nexa.target

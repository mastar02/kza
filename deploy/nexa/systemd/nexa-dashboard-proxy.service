[Unit]
Description=Nexa Local TLS Reverse Proxy (NGINX :9540 -> 127.0.0.1:9500)
PartOf=nexa.target
After=network-online.target nexa-web.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120s

[Service]
Type=simple
ExecStart=/usr/sbin/nginx -c /etc/nexa/nginx-proxy.conf -g "daemon off;"
RuntimeDirectory=nexa-proxy
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ReadWritePaths=/var/lib/nexa/proxy
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
RestrictSUIDSGID=yes
MemoryMax=256M
CPUQuota=100%
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s

[Install]
WantedBy=nexa.target

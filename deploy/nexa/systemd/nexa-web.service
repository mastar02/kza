[Unit]
Description=Nexa Independent Web Control Plane (Axum, Auth/RBAC, WS Fan-out, Vite SPA)
PartOf=nexa.target
After=network-online.target nexa-brain.service nexa-memoryd.service nexa-audiod.service
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=120s

[Service]
Type=notify
ExecStart=/opt/nexa/current/bin/nexa-web --config /etc/nexa --static-dir /opt/nexa/current/frontend
EnvironmentFile=/etc/nexa/secrets/web.env
RuntimeDirectory=nexa
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/lib/nexa/auth
LockPersonality=yes
RestrictSUIDSGID=yes
MemoryMax=1G
CPUQuota=200%
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
WatchdogSec=30s

[Install]
WantedBy=nexa.target

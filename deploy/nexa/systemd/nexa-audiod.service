[Unit]
Description=Nexa Real-Time Audio Edge Daemon (ALSA, XVF3800, MA1260, ONNX CPU)
PartOf=nexa.target
After=sound.target

[Service]
Type=notify
Environment=ORT_DYLIB_PATH=/opt/nexa/lib/libonnxruntime.so
ExecStart=/opt/nexa/current/bin/nexa-audiod --config-dir /etc/nexa
RuntimeDirectory=nexa
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/nexa/audiod /var/lib/nexa/clips
LockPersonality=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
MemoryMax=2G
CPUQuota=400%
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=120s
TimeoutStopSec=10s
WatchdogSec=30s

[Install]
WantedBy=nexa.target

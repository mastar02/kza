[Unit]
Description=Nexa Real-Time Audio Edge Daemon (ALSA, XVF3800, MA1260, ONNX CPU)
PartOf=nexa.target
After=sound.target
StartLimitBurst=5
StartLimitIntervalSec=120s

[Service]
Type=notify
Environment=ORT_DYLIB_PATH=/opt/nexa/lib/libonnxruntime.so
ExecStart=/opt/nexa/current/bin/nexa-audiod --config-dir /etc/nexa
RuntimeDirectory=nexa
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_NETLINK
ReadWritePaths=/var/lib/nexa/audiod /var/lib/nexa/clips
LockPersonality=yes
RestrictSUIDSGID=yes
MemoryMax=8G
CPUQuota=1200%
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
WatchdogSec=30s

[Install]
WantedBy=nexa.target

[Unit]
Description=Nexa Real-Time Audio Edge Daemon (ALSA, XVF3800, MA1260, ONNX CPU)
PartOf=nexa.target
After=sound.target

[Service]
Type=notify
ExecStart=/opt/nexa/current/bin/nexa-audiod --config /etc/nexa
RuntimeDirectory=nexa
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
LockPersonality=yes
RestrictSUIDSGID=yes
IPAddressDeny=any
MemoryMax=2G
CPUQuota=400%
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
StartLimitIntervalSec=120s
TimeoutStopSec=10s
WatchdogSec=30s

[Install]
WantedBy=nexa.target
